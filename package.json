{
  "name": "rental-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @rental-studio/web dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky",
    "docker:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker/docker-compose.yml up",
    "docker:prod:build": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -p rental-studio down",
    "docker:clean": "docker compose -p rental-studio down -v --rmi local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
